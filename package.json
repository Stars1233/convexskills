{
  "name": "@waynesutton/builder-skills",
  "version": "2.0.0",
  "description": "Agent skills for builders shipping Convex apps. Convex patterns plus the PRD, task, changelog, and files.md workflow. Works with Claude Code, Codex, Cursor, OpenCode, and any agent that reads SKILL.md.",
  "author": "Wayne Sutton <https://waynesutton.ai> (@waynesutton)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynesutton/builder-skills.git"
  },
  "homepage": "https://github.com/waynesutton/builder-skills#readme",
  "bugs": {
    "url": "https://github.com/waynesutton/builder-skills/issues"
  },
  "keywords": [
    "convex",
    "builder-skills",
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "llm",
    "developer-tools",
    "prd",
    "changelog",
    "skills-sh"
  ],
  "type": "module",
  "main": "index.js",
  "bin": {
    "builder-skills": "./bin/cli.js"
  },
  "files": [
    ".claude-plugin/",
    "skills/**/*.md",
    "skills/**/agents/openai.yaml",
    "skills/**/assets/*",
    "templates/**/*",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "index.js",
    "bin/"
  ],
  "scripts": {
    "check": "node scripts/check-skills.mjs",
    "prepublishOnly": "node scripts/check-skills.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
